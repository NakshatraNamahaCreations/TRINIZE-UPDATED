# copy to .env and fill in
NODE_ENV=development
PORT=4000
# local Postgres 17, or the AWS RDS URL in staging/prod
DATABASE_URL=postgres://trinize:trinize@localhost:5432/trinize
# 32+ random characters; different per environment
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# where the apps are served from (comma-separated) — for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081
# console = print codes to the server log (dev); msg91 = real SMS once DLT is approved
SMS_PROVIDER=console
# WhatsApp / SMS / email leaving the app. console = written to the server log; emailjs = email really goes out
# through EmailJS (WhatsApp and SMS stay logged). For emailjs, the template uses {{to_email}}, {{subject}}, {{message}},
# and Account → Security → "Allow EmailJS API for non-browser applications" must be on.
MESSAGING=console
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# staging/demo only: every OTP is this code. Ignored when NODE_ENV=production.
FIXED_OTP=
# optional — with a key the assistant, moderation and tone rewrite use OpenAI GPT; without it, built-in rules
OPENAI_API_KEY=
# the model that answers residents' questions (must support structured outputs)
AI_MODEL=gpt-5.4-mini
# the model for moderation and tone rewrite — runs on every post, so pick a fast, cheap one. Empty = same as AI_MODEL
AI_MODEL_FAST=gpt-5.4-nano
# reasoning effort for models that support it (gpt-5 and later): none | minimal | low | medium | high. Empty = not sent
AI_REASONING=low
# chosen with: npm run ai:bench -- gpt-5.4-mini:low gpt-5.4-nano:low   (re-run it before changing models)
# each person's AI allowance — per minute, and per day (resets at midnight India time). 0 = no limit.
# residents chatting with the Community Assistant
AI_CHAT_PER_MINUTE=6
AI_CHAT_PER_DAY=60
# residents' "Help me rewrite" / tone rewrite
AI_REWRITE_PER_MINUTE=6
AI_REWRITE_PER_DAY=40
# society console assistant: ask, draft a message, triage
AI_STAFF_PER_MINUTE=15
AI_STAFF_PER_DAY=300
# what each model costs, for the AI usage report: USD per 1 million tokens (input, cached input, output).
# Copy the current figures from your provider's pricing page; a model left out shows tokens with "price not set".
# AI_PRICES={"gpt-5.4-mini":{"input":0,"cachedInput":0,"output":0},"gpt-5.4-nano":{"input":0,"cachedInput":0,"output":0}}
AI_PRICES=
# public base URL for uploaded files
PUBLIC_URL=http://localhost:4000
