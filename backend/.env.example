# copy to .env and fill in
NODE_ENV=development
PORT=4000
# local Postgres 17, or the AWS RDS URL in staging/prod
DATABASE_URL=postgres://trinize:trinize@localhost:5432/trinize
# 32+ random characters; different per environment
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# where the apps are served from (comma-separated) — for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081
# console = print codes to the server log (dev); msg91 = real SMS once DLT is approved
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# staging/demo only: every OTP is this code. Ignored when NODE_ENV=production.
FIXED_OTP=
# optional — with a key the assistant, moderation and tone rewrite use OpenAI GPT; without it, built-in rules
OPENAI_API_KEY=
# the model that answers residents' questions (must support structured outputs)
AI_MODEL=gpt-5.4-mini
# the model for moderation and tone rewrite — runs on every post, so pick a fast, cheap one. Empty = same as AI_MODEL
AI_MODEL_FAST=gpt-5.4-nano
# reasoning effort for models that support it (gpt-5 and later): none | minimal | low | medium | high. Empty = not sent
AI_REASONING=low
# chosen with: npm run ai:bench -- gpt-5.4-mini:low gpt-5.4-nano:low   (re-run it before changing models)
# public base URL for uploaded files
PUBLIC_URL=http://localhost:4000
